{
	"name": "bronify",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm pre-build && vite build",
		"build:android": "pnpm build && pnpm cap-run:android",
		"build:ios": "pnpm build && pnpm cap-run:ios",
		"cap-run:android": "cap sync android && cap open android",
		"cap-run:ios": "cap sync ios && cap open ios",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"collect": "node --experimental-strip-types scripts/collect.ts",
		"tag": "cd scripts && uv run classify.py && cd .. && node --experimental-strip-types scripts/apply_tags.ts",
		"lyrics": "cd scripts/inner && uv run make_lyrics.py && cd ../.. && pnpm fix-lyrics && node --experimental-strip-types scripts/lyrics_index.ts",
		"hash": "node --experimental-strip-types scripts/hash_file.ts",
		"add-thumb": "node --experimental-strip-types scripts/add_thumb.ts",
		"missing-lyrics": "node --experimental-strip-types scripts/missing_lyrics.ts",
		"add-audio": "node --experimental-strip-types scripts/add_audio.ts",
		"add-lyrics": "node --experimental-strip-types scripts/add_lyrics.ts",
		"fix-lyrics": "node --experimental-strip-types scripts/segment_lyrics.ts",
		"stats": "node --experimental-strip-types scripts/stats.ts",
		"add-album-art": "node --experimental-strip-types scripts/add_album_art.ts",
		"pre-build": "node --experimental-strip-types scripts/pre_build.ts && node --experimental-strip-types scripts/lyrics_index.ts && node --experimental-strip-types scripts/karaoke.ts",
		"sync": "pnpm collect && pnpm tag && pnpm pre-build && pnpm capitals",
		"capitals": "node --experimental-strip-types scripts/capitals.ts"
	},
	"devDependencies": {
		"@capacitor/assets": "^3.0.5",
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-cloudflare": "^6.0.1",
		"@sveltejs/adapter-static": "^3.0.8",
		"@sveltejs/enhanced-img": "^0.4.4",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@tauri-apps/cli": "1",
		"@types/fluent-ffmpeg": "^2.1.27",
		"@types/node": "^22.13.11",
		"@types/nprogress": "^0.2.3",
		"color": "^5.0.0",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"fluent-ffmpeg": "^2.1.3",
		"globals": "^16.0.0",
		"nprogress": "^0.2.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"sharp": "^0.33.5",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["esbuild"]
	},
	"dependencies": {
		"@capacitor/android": "^7.1.0",
		"@capacitor/cli": "^7.1.0",
		"@capacitor/core": "^7.1.0",
		"@capacitor/ios": "^7.1.0",
		"@capacitor/status-bar": "^7.0.0",
		"@fontsource-variable/inter": "^5.2.5",
		"@lucide/svelte": "^0.483.0",
		"@svelte-put/shortcut": "^4.1.0",
		"axios": "^1.8.4",
		"daisyui": "^5.0.9",
		"fuse.js": "^7.1.0",
		"svelte-device-info": "^1.0.6",
		"ua-parser-js": "^2.0.3"
	}
}
