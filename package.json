{
	"name": "bronify",
	"private": true,
	"version": "0.0.1",
	"type": "module",
	"scripts": {
		"dev": "vite dev",
		"build": "pnpm pre-build && vite build",
		"preview": "vite preview",
		"prepare": "svelte-kit sync || echo ''",
		"check": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json",
		"check:watch": "svelte-kit sync && svelte-check --tsconfig ./tsconfig.json --watch",
		"format": "prettier --write .",
		"lint": "prettier --check . && eslint .",
		"collect": "node --experimental-strip-types scripts/collect.ts",
		"tag": "uv run scripts/classify.py && node --experimental-strip-types scripts/apply_tags.ts",
		"hash": "node --experimental-strip-types scripts/hash_file.ts",
		"add-thumb": "node --experimental-strip-types scripts/add_thumb.ts",
		"missing-lyrics": "node --experimental-strip-types scripts/missing_lyrics.ts",
		"add-audio": "node --experimental-strip-types scripts/add_audio.ts",
		"add-lyrics": "node --experimental-strip-types scripts/add_lyrics.ts",
		"stats": "node --experimental-strip-types scripts/stats.ts",
		"add-album-art": "node --experimental-strip-types scripts/add_album_art.ts",
		"pre-build": "node --experimental-strip-types scripts/pre_build.ts"
	},
	"devDependencies": {
		"@eslint/compat": "^1.2.5",
		"@eslint/js": "^9.18.0",
		"@sveltejs/adapter-cloudflare": "^5.0.1",
		"@sveltejs/enhanced-img": "^0.4.4",
		"@sveltejs/kit": "^2.16.0",
		"@sveltejs/vite-plugin-svelte": "^5.0.0",
		"@tailwindcss/typography": "^0.5.15",
		"@tailwindcss/vite": "^4.0.0",
		"@types/node": "^22.13.11",
		"eslint": "^9.18.0",
		"eslint-config-prettier": "^10.0.1",
		"eslint-plugin-svelte": "^3.0.0",
		"globals": "^16.0.0",
		"prettier": "^3.4.2",
		"prettier-plugin-svelte": "^3.3.3",
		"prettier-plugin-tailwindcss": "^0.6.11",
		"sharp": "^0.33.5",
		"svelte": "^5.0.0",
		"svelte-check": "^4.0.0",
		"tailwindcss": "^4.0.0",
		"typescript": "^5.0.0",
		"typescript-eslint": "^8.20.0",
		"vite": "^6.0.0"
	},
	"pnpm": {
		"onlyBuiltDependencies": ["esbuild"]
	},
	"dependencies": {
		"@lucide/svelte": "^0.483.0",
		"@svelte-put/shortcut": "^4.1.0",
		"axios": "^1.8.4",
		"daisyui": "^5.0.9",
		"fuse.js": "^7.1.0",
		"svelte-device-info": "^1.0.6"
	}
}
